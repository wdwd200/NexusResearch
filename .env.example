# 复制为 .env 后填写。本文件是 dotenv，不要再包成 Markdown。
# 不修改已有 .env。模型是否可用以当前账号和供应商实际支持为准。

# 对话模型（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat
LLM_TIMEOUT_SECONDS=120

# 并发上限：单进程允许同时在途的模型请求数
LLM_MAX_CONCURRENCY=3
# SDK 重试之外的额外重试次数，用于覆盖上游偶发 5xx
LLM_EXTRA_RETRIES=1
# 兼容强制返回 SSE 的上游网关，流式读取后再聚合
LLM_FORCE_STREAMING=true

# Embedding / Rerank
# 代码里有模型名白名单，改名前先看 app/config.py。
# local 只用于离线联调，不是线上检索。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_PROVIDER=siliconflow
RERANK_PROVIDER=siliconflow

# 向量库
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=internal_kb
# QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=30

# 业务库
# 工具层用 sqlglot 限制单条只读 SQL。
# 部署计划：生产连接使用单独的只读账号，不使用 root，也不在本示例里执行授权。
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=nexus_readonly
MYSQL_PASSWORD=
MYSQL_DATABASE=nexus_research_db
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
MYSQL_ROOT_PASSWORD=

# 联网搜索
TAVILY_API_KEY=

# 状态账本与上下文
# CONTEXT_MAX_CHARS 是字符估算，不是严格 token。
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
CONTEXT_MAX_CHARS=24000
HITL_INTERRUPT_TOOLS=convert_md_to_pdf

# 接口鉴权
# 留空则本地不校验。设置后是单进程共享演示口令，不是用户隔离。
ACCESS_TOKEN=

# 前端构建期变量
# 演示口令只进入请求头和 WebSocket 握手，不写入下载链接。
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_ACCESS_TOKEN=
